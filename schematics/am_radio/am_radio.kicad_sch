	(text "AM receiver, 530-1700 kHz, 9 V battery\nTank: f = 1 / (2 pi sqrt(L1 C)), L1 = 240 uH\n  f_low  = 1 / (2 pi sqrt(240 uH x 375 pF)) = 530 kHz\n  f_high = 1 / (2 pi sqrt(240 uH x 36.5 pF)) = 1700 kHz\n  C2 12-365 pF + ~20 pF strays/C1 = 32-385 pF: 1.82 MHz-523 kHz\nDetector D1 BAT85; RV1 (100k log volume) is its load:\n  tau = RV1 x C3 = 100k x 330 pF = 33 us, audio -3 dB 4.8 kHz\nC4: 1 / (2 pi x 50k R_in x 100 nF) = 32 Hz\nLM386 gain 20 (pins 1, 8 open); C8: 1 / (2 pi x 8R x 220 uF) = 90 Hz\nZobel R3 + C9 = 10R + 47 nF"
		(exclude_from_sim no)
		(at 106.68 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
