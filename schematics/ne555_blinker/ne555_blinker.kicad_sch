	(text "NE555 astable, 9 V battery, LED blinks at ~5 Hz\nt_on  = 0.693 (R1 + R2) C1 = 0.693 x 16.7 k x 10 uF = 116 ms\nt_off = 0.693 R2 C1 = 0.693 x 12 k x 10 uF = 83 ms\nf = 1 / (t_on + t_off) = 5.0 Hz, duty 58 %\nI_LED = (V_OH - V_F) / R3 = (7.6 V - 2.0 V) / 470 R = 12 mA"
		(exclude_from_sim no)
		(at 60.96 80.01 0)
